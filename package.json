{
	"name": "create-ink-app-with-bun",
	"version": "3.0.9",
	"description": "Generate a starter Ink app with Bun",
	"keywords": [
		"ink",
		"ink-app",
		"cli"
	],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/involvex/create-ink-app-with-bun.git"
	},
	"funding": {
		"url": "https://github.com/sponsors/involvex"
	},
	"license": "MIT",
	"author": {
		"name": "involvex"
	},
	"type": "module",
	"bin": {
		"create-ink-app-with-bun": "cli.js"
	},
	"files": [
		"index.js",
		"cli.js",
		"templates"
	],
	"scripts": {
		"dev": "bun run cli.js",
		"format": "bun fmt --ignore-pattern \"templates/**\"",
		"lint": "bun lint --ignore-pattern \"templates/**\"",
		"test": "bun test --timeout 300000",
		"verify": "bun run format && bun run lint && bun run test"
	},
	"dependencies": {
		"cpy": "^13.2.1",
		"execa": "^9.6.1",
		"has-flag": "^5.0.1",
		"listr": "^0.14.3",
		"make-dir": "^5.1.0",
		"meow": "^14.1.0",
		"prompts": "^2.4.2",
		"replace-string": "^4.0.0",
		"slugify": "^1.6.9"
	},
	"devDependencies": {
		"del": "^8.0.1",
		"strip-ansi": "^7.2.0",
		"tempy": "^3.2.0"
	},
	"engines": {
		"node": ">=16"
	},
	"sponsor": {
		"url": "https://github.com/sponsors/involvex"
	}
}
